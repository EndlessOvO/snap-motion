# Optional OpenAI-compatible provider.
# Leave these empty to use the built-in local heuristic generator.
OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
OPENAI_COMPATIBLE_API_KEY=replace-me
OPENAI_COMPATIBLE_MODEL=your-vision-capable-model

# Optional identity-preserving cartoon reference prompt pass.
AVATAR_CARTOON_REFERENCE_AI=0

# Optional Ready Player Me Avatar Creator subdomain for browser-side avatar creation.
# The page can open https://<subdomain>.readyplayer.me/avatar?frameApi and import
# the exported GLB URL through postMessage.
NEXT_PUBLIC_READY_PLAYER_ME_SUBDOMAIN=demo
# Optional full Creator URL override, useful for custom domains/tests.
NEXT_PUBLIC_READY_PLAYER_ME_CREATOR_URL=

# Optional generated Avatar GLB/GLTF.
# Use this as the first integration seam for Avatar SDK/MetaPerson, MetaHuman SDK,
# Avaturn, Ready Player Me, or another Avatar service that returns a web-loadable GLB URL.
AVATAR_MODEL_URL=

# Optional dynamic model provider. Leave empty to auto-detect provider-specific keys
# for avatar-specialized providers only, or use AVATAR_MODEL_URL/local fallback.
# AVATAR_MODEL_PROVIDER can be: mock, generic-glb, hunyuan3d, fal-hunyuan3d, tripo3d, meshy, replicate, rodin, stable-fast-3d, avaturn, ready-player-me, avatar-sdk, metahuman-sdk.
AVATAR_MODEL_PROVIDER=
AVATAR_MODEL_PROVIDER_CHAIN=
# Leave this at 0 for production Avatar checks. Set to 1 only when you explicitly
# want provider-specific keys for generic image-to-3D services to auto-run too.
AVATAR_MODEL_ALLOW_IMAGE_TO_3D_AUTODETECT=0
AVATAR_MODEL_API_URL=
AVATAR_MODEL_API_KEY=
# AVATAR_MODEL_REQUEST_FORMAT can be: generic-json, generic-multipart, avatar-url-json, avatar-sdk-metaperson-api, avaturn-api, metahuman-sdk-pipeline, hunyuan3d-json, fal-hunyuan3d-json, fal-tripo-h31-json, tripo-openapi-image-to-model, meshy-image-to-3d-json, replicate-prediction-json, rodin-gen2-multipart, stable-fast-3d-multipart.
# hunyuan3d-json uses self-hosted Tencent Hunyuan3D FastAPI on http://127.0.0.1:8081/send by default.
# fal-hunyuan3d-json uses https://queue.fal.run/fal-ai/hunyuan3d/v2/turbo by default and requires AVATAR_MODEL_FAL_HUNYUAN3D_API_KEY or AVATAR_MODEL_API_KEY.
# fal-tripo-h31-json uses https://queue.fal.run/tripo3d/h3.1/image-to-3d by default and requires AVATAR_MODEL_API_KEY=your_fal_key.
# replicate-prediction-json uses Replicate predictions by default and requires AVATAR_MODEL_REPLICATE_API_KEY plus AVATAR_MODEL_REPLICATE_MODEL or AVATAR_MODEL_REPLICATE_VERSION.
AVATAR_MODEL_REQUEST_FORMAT=generic-json

# Set to 1 when evaluating quality so a missing/failed provider returns an error
# instead of silently using the local Morph GLB placeholder.
AVATAR_MODEL_REQUIRE_REAL_GLB=0

# For self-hosted Hunyuan3D 2.1 FastAPI. This is an image-to-3D asset route,
# not the default eight-tenths Avatar route. Defaults match official api_server.py.
AVATAR_MODEL_HUNYUAN3D_API_URL=http://127.0.0.1:8081/send
AVATAR_MODEL_HUNYUAN3D_POLL_URL=http://127.0.0.1:8081/status/{taskId}
AVATAR_MODEL_HUNYUAN3D_REMOVE_BACKGROUND=true
AVATAR_MODEL_HUNYUAN3D_TEXTURE=true
AVATAR_MODEL_HUNYUAN3D_SEED=1234
AVATAR_MODEL_HUNYUAN3D_OCTREE_RESOLUTION=256
AVATAR_MODEL_HUNYUAN3D_NUM_INFERENCE_STEPS=5
AVATAR_MODEL_HUNYUAN3D_GUIDANCE_SCALE=5
AVATAR_MODEL_HUNYUAN3D_NUM_CHUNKS=8000
AVATAR_MODEL_HUNYUAN3D_FACE_COUNT=40000
AVATAR_MODEL_HUNYUAN3D_OUTPUT_TYPE=glb

# For Meshy image-to-3D. Defaults use Meshy latest/v6-style options for textured GLB output.
AVATAR_MODEL_MESHY_AI_MODEL=latest
AVATAR_MODEL_MESHY_TOPOLOGY=quad
AVATAR_MODEL_MESHY_TARGET_POLYCOUNT=50000
AVATAR_MODEL_MESHY_SHOULD_TEXTURE=true
AVATAR_MODEL_MESHY_SHOULD_REMESH=true
AVATAR_MODEL_MESHY_ENABLE_PBR=true
AVATAR_MODEL_MESHY_TEXTURE_PROMPT=soft 3D cartoon avatar material, clean skin tones, accurate hair color, no extra glasses, no hats, no jewelry, neutral studio lighting

# For Replicate-hosted image-to-3D models such as hosted Hunyuan3D/TRELLIS variants.
AVATAR_MODEL_REPLICATE_MODEL=
AVATAR_MODEL_REPLICATE_VERSION=
AVATAR_MODEL_REPLICATE_IMAGE_FIELD=image
AVATAR_MODEL_REPLICATE_PROMPT_FIELD=prompt
AVATAR_MODEL_REPLICATE_NEGATIVE_PROMPT_FIELD=negative_prompt
AVATAR_MODEL_REPLICATE_OUTPUT_FORMAT_FIELD=output_format
AVATAR_MODEL_REPLICATE_OUTPUT_FORMAT=glb
AVATAR_MODEL_REPLICATE_WAIT_SECONDS=5

# For async providers: submit image to AVATAR_MODEL_API_URL, then poll this URL.
# Use {taskId} as placeholder, for example: https://api.example.com/tasks/{taskId}
AVATAR_MODEL_POLL_URL=
AVATAR_MODEL_MAX_POLLS=20
AVATAR_MODEL_POLL_INTERVAL_MS=1500

# Optional response path overrides for providers with different JSON shapes.
AVATAR_MODEL_TASK_ID_PATHS=
AVATAR_MODEL_MODEL_URL_PATHS=
AVATAR_MODEL_STATUS_PATHS=
AVATAR_MODEL_SUCCESS_STATUSES=

# Local mock path for validating the GLB route without a real provider.
AVATAR_MODEL_MOCK_URL=/models/generated-avatar-fixture.glb
